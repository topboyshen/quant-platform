[Unit]
Description=quant-platform import of offline ETF research score (read-only)

[Timer]
OnCalendar=Mon..Fri *-*-* 16:55:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 17:25:00 Asia/Shanghai
AccuracySec=10s
Persistent=false
Unit=qp-job@research.etf_score_import.service

[Install]
WantedBy=timers.target
