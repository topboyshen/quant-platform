[Unit]
Description=quant-platform API (FastAPI, 127.0.0.1:18800)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=qp
Group=qp
EnvironmentFile=/etc/qp/qp.env
WorkingDirectory=/opt/qp/current/backend
ExecStart=/opt/qp/current/venv/bin/uvicorn qp.api.main:app --host 127.0.0.1 --port 18800 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=5
MemoryMax=300M
MemoryHigh=250M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/qp
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
