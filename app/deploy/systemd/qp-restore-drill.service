[Unit]
Description=quant-platform backup restore drill into a scratch database
After=postgresql.service

[Service]
Type=oneshot
User=root
ExecStartPre=/usr/bin/install -d -m 0750 /var/lib/qp/restore-drills
ExecStart=/usr/local/sbin/qp-restore-drill --out /var/lib/qp/restore-drills/latest.txt
TimeoutStartSec=15min
Nice=10
