[Unit]
Description=quant-platform legacy collector every 10 min (skips 07:45-08:25, 15:00-16:25, 21:40-23:15 CST)

[Timer]
OnCalendar=*-*-* 00..06:00/10:00 Asia/Shanghai
OnCalendar=*-*-* 07:00,10,20,30,40:00 Asia/Shanghai
OnCalendar=*-*-* 08:30,40,50:00 Asia/Shanghai
OnCalendar=*-*-* 09..14:00/10:00 Asia/Shanghai
OnCalendar=*-*-* 16:30,40,50:00 Asia/Shanghai
OnCalendar=*-*-* 17..20:00/10:00 Asia/Shanghai
OnCalendar=*-*-* 21:00,10,20,30:00 Asia/Shanghai
OnCalendar=*-*-* 23:20,30,40,50:00 Asia/Shanghai
AccuracySec=30s
Persistent=false
Unit=qp-collect.service

[Install]
WantedBy=timers.target
