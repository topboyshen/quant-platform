# /etc/qp/qp.env (root:qp 0640) - no secrets required (PostgreSQL peer auth over the local socket)
QP_DATABASE_URL=postgresql+psycopg:///qp?host=/var/run/postgresql
QP_BACKUP_DIR=/var/lib/qp/backups
QP_BACKUP_KEEP_DAYS=14
QP_SESSION_TTL_HOURS=168
QP_COOKIE_PATH=/next/
QP_COOKIE_SECURE=1
QP_API_HEALTH_URL=http://127.0.0.1:18800/api/health
# M4 signals stay shadow-only: no Telegram/dedirock POST and no legacy outbox write.
QP_NOTIFY_MODE=shadow
QP_APP_DIR=/opt/qp/current/backend
# M4 secret files hold raw bytes; install as root:qp 0640 (never put the value here).
QP_APPROVED_SIGNALS_HMAC_FILE=/etc/qp/approved_signals_hmac
QP_APPROVED_SIGNALS_MAX_SKEW_SEC=300
QP_EXECUTION_DIGEST_HMAC_FILE=/etc/qp/dedirock_digest_hmac
QP_EXECUTION_DIGEST_DIR=/var/lib/qp/signals/digests
QP_RISK_OVERRIDE_FILE=/var/lib/qp/radar_risk_override.json
PATH=/usr/lib/postgresql/16/bin:/usr/bin:/bin

# M5 research shadow: read-only sources. Keep any DSN password in /etc/qp/qp.env (root:qp 0640).
QP_LEDGER_DSN=postgresql+psycopg:///research_ledger?host=/var/run/postgresql
QP_PHASE2_DB=/var/lib/research-system-phase2/phase2.db
QP_QD_DSN=postgresql+psycopg://qp_ro:__SET_ME__@<container-ip>:5432/<qd-db>
QP_LLM_SHADOW=1
QP_RESEARCH_REPORT_DIR=/var/lib/qp/research-reports

# M6 reports shadow: read-only legacy report files and Hermes ledger; no sending.
QP_LEGACY_DAILY_DIR=/home/ubuntu/trading-radar/data/daily-research-summary/1
QP_RESEARCH_DIGEST_JSON=/home/ubuntu/trading-radar/data/research_digest.json
QP_HERMES_ORIGINALS_DIR=/home/ubuntu/trading-radar/data/daily-research-summary/1/originals
QP_HERMES_DELIVERIES_DB=/home/ubuntu/.hermes/cron/deliveries.db
QP_HERMES_EXECUTIONS_DB=/home/ubuntu/.hermes/cron/executions.db
QP_REPORTS_REPORT_DIR=/var/lib/qp/report-reports

# M8 morning chain shadow: read-only legacy artifacts; no relay and no alerts.
QP_MORNING_ASTOCK_ROOT=/home/ubuntu/AStock_AI_System
QP_SIGNAL_BUS_ROOT=/home/ubuntu/signal-bus
QP_SIGNAL_BUS_STATE=/home/ubuntu/.local/state/signal-bus
