# /etc/qp/qp.env (root:qp 0640) - no secrets required (PostgreSQL peer auth over the local socket)
QP_DATABASE_URL=postgresql+psycopg:///qp?host=/var/run/postgresql
QP_BACKUP_DIR=/var/lib/qp/backups
QP_BACKUP_KEEP_DAYS=14
QP_SESSION_TTL_HOURS=168
QP_COOKIE_PATH=/next/
QP_COOKIE_SECURE=1
QP_API_HEALTH_URL=http://127.0.0.1:18800/api/health
# M4 signals stay shadow-only: no Telegram/dedirock POST and no legacy outbox write.
QP_NOTIFY_MODE=shadow
QP_APP_DIR=/opt/qp/current/backend
# M4 secret files hold raw bytes; install as root:qp 0640 (never put the value here).
QP_APPROVED_SIGNALS_HMAC_FILE=/etc/qp/approved_signals_hmac
QP_APPROVED_SIGNALS_MAX_SKEW_SEC=300
QP_EXECUTION_DIGEST_HMAC_FILE=/etc/qp/dedirock_digest_hmac
QP_EXECUTION_DIGEST_DIR=/var/lib/qp/signals/digests
QP_RISK_OVERRIDE_FILE=/var/lib/qp/radar_risk_override.json
PATH=/usr/lib/postgresql/16/bin:/usr/bin:/bin
