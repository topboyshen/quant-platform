# Migrated from Quant-Server quantdinger-public on 2026-11-11; served on 150.158.46.28:8443
log_format approved_redacted escape=json
    '{"ts":"$time_iso8601","status":$status,"sent":$body_bytes_sent,"duration":$request_time,"id":"$request_id"}';
# QuantDinger public HTTPS entrypoint.
# The container remains loopback-only; Nginx is the sole public ingress.

limit_req_zone $binary_remote_addr zone=quantdinger_general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=quantdinger_login:10m rate=6r/m;

map $http_upgrade $quantdinger_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8443 ssl;
    server_name 150.158.46.28;

    server_tokens off;
    access_log /var/log/nginx/qd-redacted-access.log approved_redacted;
    client_max_body_size 10m;

    ssl_certificate /etc/letsencrypt/live/nng8-dashboard-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nng8-dashboard-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:QuantDingerSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # The frontend currently renders trusted report markup with innerHTML.
    # Block executable inline attributes/scripts at the public boundary while
    # retaining the app's inline CSS, Pyodide worker and optional Turnstile.
    proxy_hide_header Content-Security-Policy;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://cdn.jsdelivr.net; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Registration is disabled in the application and also blocked at ingress.

    # Make password guessing materially slower without affecting normal API use.


    # Quant approved-signals intake (high-entropy path; loopback only upstream)
    location /__APPROVED_SIGNALS_SECRET_PATH__/ {
        limit_req zone=quantdinger_general burst=20 nodelay;
        proxy_pass http://127.0.0.1:8094/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Timestamp $http_x_timestamp;
        proxy_set_header X-Signature $http_x_signature;
        proxy_set_header X-Source $http_x_source;
        proxy_read_timeout 30s;
    }


    # quant-platform P2 (2026-11-11): QuantDinger moved to https://150.158.46.28/qd/ (443); approved-signals location above unchanged
    location ^~ /api/ {
        return 308 https://150.158.46.28$request_uri;
    }
    location / {
        return 301 https://150.158.46.28/qd$request_uri;
    }
    location ~ /\.(?:git|env|htpasswd)(?:/|$) {
        deny all;
        return 403;
    }
}
