# Read-only dashboard, localhost only. Static pages from /opt, data from /var/lib.
# No directory listing, no dotfiles, no upstream, no request logging of bodies.
server {
    listen 127.0.0.1:8080;
    listen [::1]:8080;
    server_name localhost;

    root /opt/nng8-dashboard;
    index index.html;

    # Static reading only: no writes, no proxying, no CGI.
    client_max_body_size 64k;
    autoindex off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    location = / {
        try_files /index.html =404;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # Exported JSON lives outside the web root; alias it read-only.
    location /data/ {
        alias /var/lib/nng8-dashboard/;
        autoindex off;
        types { application/json json; }
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'" always;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. {
        deny all;
    }
}
