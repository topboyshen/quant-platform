[Unit]
Description=Reconcile an unconfirmed research-data health delivery without sending

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/research-data
Environment=RESEARCH_DATA_HEALTH_JSON=/var/lib/research-data-health/last.json
ExecStart=/home/ubuntu/research-data/scripts/run_health_alert.sh --review-unconfirmed
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
