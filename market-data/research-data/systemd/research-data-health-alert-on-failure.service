[Unit]
Description=Alert when the research-data health audit unit itself fails

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/research-data
Environment=RESEARCH_DATA_HEALTH_JSON=/var/lib/research-data-health/last.json
ExecStart=/home/ubuntu/research-data/scripts/run_health_alert.sh
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
