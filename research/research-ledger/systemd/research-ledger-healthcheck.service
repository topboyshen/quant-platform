[Unit]
Description=Research Ledger local health check
After=research-ledger.service

[Service]
Type=oneshot
User=researchledger
Group=researchledger
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 5 http://127.0.0.1:18769/health
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
PrivateDevices=true
MemoryMax=64M
CPUQuota=10%
TasksMax=32
