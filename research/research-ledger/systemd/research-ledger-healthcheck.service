[Unit]
Description=Research Ledger local health check
After=research-ledger.service research-ledger-backup.service
OnFailure=research-ledger-alert@%n.service

[Service]
Type=oneshot
User=researchledger
Group=researchledger
ExecStart=/opt/research-ledger/scripts/research-ledger-runtime-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
PrivateDevices=true
MemoryMax=64M
CPUQuota=10%
TasksMax=32
