[Unit]
Description=Research feedback pipeline daily completion check
After=research-ledger-worker.service
OnFailure=research-ledger-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/research-ledger/scripts/research-ledger-pipeline-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=64M
CPUQuota=10%
TasksMax=32
