[Unit]
Description=Research System Phase 2 loopback dashboard
After=network-online.target

[Service]
Type=simple
User=researchphase2
Group=researchphase2
WorkingDirectory=/opt/research-system-phase2
ExecStart=/opt/research-system-phase2/.venv/bin/python /opt/research-system-phase2/app/server.py --db /var/lib/research-system-phase2/phase2.db --protocol /opt/research-system-phase2/protocol/calibration_protocol_v1.json --port 18768
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/research-system-phase2

[Install]
WantedBy=multi-user.target
