{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astock.local/schemas/xhs-draft-v1.schema.json",
  "title": "AStock deterministic XHS draft manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "draftId",
    "idempotencyKey",
    "state",
    "draftEligible",
    "publishEligible",
    "humanApprovalRequired",
    "publishBlockers",
    "targetDate",
    "generatedAt",
    "source",
    "contentMode",
    "content",
    "disclaimer"
  ],
  "properties": {
    "schemaVersion": { "const": "astock.xhs-draft.v1" },
    "kind": { "const": "xhs_draft" },
    "draftId": { "type": "string", "pattern": "^astock-xhs-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{16}-v1$" },
    "idempotencyKey": { "type": "string", "pattern": "^astock:xhs-draft:v1:\\d{4}-\\d{2}-\\d{2}:[0-9a-f]{64}$" },
    "state": { "const": "DRAFT_ONLY" },
    "draftEligible": { "const": true },
    "publishEligible": { "const": false },
    "humanApprovalRequired": { "const": true },
    "publishBlockers": {
      "type": "array",
      "const": ["AUTO_PUBLISH_DISABLED", "HUMAN_APPROVAL_REQUIRED"]
    },
    "targetDate": { "type": "string", "format": "date" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lastRunFile",
        "lastRunSha256",
        "reportFile",
        "reportSha256",
        "contextSha256",
        "dataStatus",
        "frozenCutoffInstant",
        "cutoffLocal",
        "publicationGate",
        "evidenceReview",
        "researchSemanticReview",
        "semanticCandidateCount"
      ],
      "properties": {
        "lastRunFile": { "const": "work/last-run.json" },
        "lastRunSha256": { "$ref": "#/$defs/sha256" },
        "reportFile": { "type": "string", "pattern": "^reports/daily/\\d{4}-\\d{2}-\\d{2}\\.md$" },
        "reportSha256": { "$ref": "#/$defs/sha256" },
        "contextSha256": { "$ref": "#/$defs/sha256" },
        "dataStatus": { "enum": ["live", "partial"] },
        "frozenCutoffInstant": { "type": "string", "format": "date-time" },
        "cutoffLocal": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$" },
        "publicationGate": { "const": "passed" },
        "evidenceReview": { "const": "passed" },
        "researchSemanticReview": { "enum": ["not_human_reviewed", "human_passed"] },
        "semanticCandidateCount": { "type": "integer", "minimum": 0 }
      }
    },
    "contentMode": { "const": "facts_only" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "tags", "cover", "sources", "bodySha256", "bodyBytes"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "cover": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "headline", "subtitle"],
          "properties": {
            "status": { "const": "not_generated" },
            "headline": { "type": "string" },
            "subtitle": { "type": "string" }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "title", "dataTime", "url"],
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 },
              "dataTime": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
            }
          }
        },
        "bodySha256": { "$ref": "#/$defs/sha256" },
        "bodyBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "disclaimer": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
