ARG BASE_IMAGE=docker.1ms.run/library/python:3.12-slim-bookworm
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
RUN groupadd --gid 1000 radar \
    && useradd --uid 1000 --gid 1000 --no-create-home --shell /usr/sbin/nologin radar

COPY --chown=radar:radar deploy/macro-risk/radar_package_init.py /app/radar/__init__.py
COPY --chown=radar:radar radar/risk/__init__.py /app/radar/risk/__init__.py
COPY --chown=radar:radar radar/risk/macro_risk_control.py /app/radar/risk/macro_risk_control.py
COPY --chown=radar:radar scripts/run_macro_risk_producer.py /app/run_macro_risk_producer.py

USER 1000:1000
EXPOSE 8093
ENTRYPOINT ["python", "/app/run_macro_risk_producer.py"]
