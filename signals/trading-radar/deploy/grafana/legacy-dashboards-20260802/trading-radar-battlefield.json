      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "editorMode": "code",
          "exemplar": false,
          "expr": "sum by (strategy_tag) (radar_strategy_tag_trade_wins_total) / sum by (strategy_tag) (radar_strategy_tag_trade_wins_total + radar_strategy_tag_trade_losses_total)",
