{
  "uid": "quant-runtime-observer-v1",
  "title": "Quant · Endpoint and Data Freshness",
  "tags": [
    "quant",
    "read-only",
    "freshness"
  ],
  "timezone": "Asia/Shanghai",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "业务端点：1 可达 / 0 失败",
      "description": "仅验证固定内部 HTTP 端点的 HTTP 200，不代表公网、深层数据库健康或用户客户端送达。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"quant-runtime-http\"}",
          "instant": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "结构：1 可读 / 0 损坏",
      "description": "文件可读且校验通过。过期不等于损坏；过期由右侧「日期陈旧」和 QuantResearchDigestInputsStale / QuantIndexCacheStale 告警。",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "radar_runtime_index_cache_valid",
          "instant": true,
          "legendFormat": "指数缓存"
        },
        {
          "refId": "B",
          "expr": "radar_runtime_digest_valid",
          "instant": true,
          "legendFormat": "研究摘要"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "日期：0 正常 / 1 陈旧",
      "description": "只看交易日是否达到期望。结构损坏见左侧「结构可读」。15:30 后期望当天，告警为 repair 留 30/35 分钟。未知日期按陈旧。",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "radar_runtime_index_cache_stale",
          "instant": true,
          "legendFormat": "指数缓存"
        },
        {
          "refId": "B",
          "expr": "radar_runtime_digest_inputs_stale",
          "instant": true,
          "legendFormat": "摘要输入"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "期望交易日 / 缓存交易日 / 摘要输入交易日",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "radar_runtime_expected_trade_date_timestamp_seconds * 1000",
          "instant": true,
          "legendFormat": "期望"
        },
        {
          "refId": "B",
          "expr": "radar_runtime_index_trade_date_timestamp_seconds * 1000",
          "instant": true,
          "legendFormat": "缓存"
        },
        {
          "refId": "C",
          "expr": "radar_runtime_digest_trade_date_timestamp_seconds * 1000",
          "instant": true,
          "legendFormat": "摘要输入"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "业务端点响应耗时",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=\"quant-runtime-http\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "摘要生成距今时间（阈值 90 分钟）",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "radar_runtime_digest_age_seconds",
          "legendFormat": "摘要年龄"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5400
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Prometheus 抓取状态（不等同于业务 probe_success）",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    }
  ]
}
