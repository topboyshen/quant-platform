[Unit]
Description=Refresh stale four-index close cache after A-share close

[Timer]
OnCalendar=Mon..Fri *-*-* 15:35:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 15:45:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 15:55:00 Asia/Shanghai
Persistent=false
AccuracySec=1min
RandomizedDelaySec=0
Unit=research-index-close-cache.service

[Install]
WantedBy=timers.target
