[Unit]
Description=Trading Radar — retain newest container images and prune old layers
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/trading_radar
ExecStart=/opt/trading_radar/scripts/prune_radar_images.sh --apply --retain 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
