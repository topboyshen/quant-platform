[Unit]
Description=Trading Radar — Quant container image retention
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/trading-radar
ExecStart=/home/ubuntu/trading-radar/scripts/prune_radar_images.sh --apply --retain 2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
