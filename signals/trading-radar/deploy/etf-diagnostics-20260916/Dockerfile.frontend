# Exact local production base; retain old hashed assets for already-open tabs.
FROM trading-radar-quantdinger-frontend:personal-2026.09.12-etf-pool.2
ARG SOURCE_SHA256
LABEL org.opencontainers.image.description="ETF trigger explanations and immutable historical dates" \
      org.opencontainers.image.revision="${SOURCE_SHA256}" \
      quant.release="personal-2026.09.16-etf-diagnostics.1"
COPY dist/ /usr/share/nginx/html/
RUN test -n "${SOURCE_SHA256}" && printf '%s\n' "${SOURCE_SHA256}" > /usr/share/nginx/html/.personal-source-sha256
