# Verified local base ID: sha256:f10639189da8b04899bc8043b9abd4ea27b10a353004edac56d4cad152017159
# Exact frozen source 35472889... + frontend.patch; never build from the divergent checkout.
FROM trading-radar-quantdinger-frontend:personal-2026.08.07-order-v2.1
ARG SOURCE_SHA256
LABEL org.opencontainers.image.description="ETF research universe UI on the frozen personal frontend" \
      org.opencontainers.image.revision="${SOURCE_SHA256}"
# Keep old hashed assets so already-open browser tabs remain compatible during rollout.
COPY dist/ /usr/share/nginx/html/
RUN test -n "${SOURCE_SHA256}" && printf '%s\n' "${SOURCE_SHA256}" > /usr/share/nginx/html/.personal-source-sha256
