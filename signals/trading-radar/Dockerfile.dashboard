# Web Dashboard（Flask，默认 8081）
# 构建: docker build -f Dockerfile.dashboard -t trading-radar-dashboard .
# 运行: docker run --rm -p 8081:8081 -v $(pwd)/config.json:/app/config.json:ro trading-radar-dashboard
ARG PYTHON_BASE_IMAGE=docker.1ms.run/library/python:3.12-slim-bookworm
FROM ${PYTHON_BASE_IMAGE}

ENV PIP_INDEX_URL=https://mirrors.tencent.com/pypi/simple/
ENV PIP_TRUSTED_HOST=mirrors.tencent.com

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY . .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir ".[dashboard]"

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8081/health', timeout=2)" || exit 1

CMD ["python", "dashboard/app.py"]
