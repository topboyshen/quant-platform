# ML 推理服务（.pkl + 可选 Redis/Memcached 缓存）
# docker build -f Dockerfile.ml-serve -t trading-radar-ml-serve .
FROM docker.1ms.run/library/python:3.12-slim-bookworm

ENV PIP_INDEX_URL=https://mirrors.tencent.com/pypi/simple/
ENV PIP_TRUSTED_HOST=mirrors.tencent.com

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY . .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir ".[ml-serve]"

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8090/health', timeout=2)" || exit 1

CMD ["python", "serve_ml.py"]
