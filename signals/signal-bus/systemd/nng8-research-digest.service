[Unit]
Description=Relay today's validated sealed research before the 08:15 merge
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/ubuntu/signal-bus/scripts/run_research_relay_with_alert.sh
EnvironmentFile=/home/ubuntu/.config/systemd/user/research-chain-alert.env
WorkingDirectory=/home/ubuntu/signal-bus
TimeoutStartSec=45s
TimeoutStopSec=5s
UMask=0077
Nice=10
NoNewPrivileges=yes
