[Unit]
Description=Retry validated sealed research at 08:05 and 08:10 Shanghai

[Timer]
OnCalendar=Mon..Fri *-*-* 08:05:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 08:10:00 Asia/Shanghai
Persistent=false
AccuracySec=5s
RandomizedDelaySec=0
Unit=nng8-research-digest.service

[Install]
WantedBy=timers.target
